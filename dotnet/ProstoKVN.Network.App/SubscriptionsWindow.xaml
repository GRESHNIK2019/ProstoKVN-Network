<Window
    x:Class="ProstoKVN.Network.App.SubscriptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ProstoKVN.Network.App.ViewModels">
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Группы подписок" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Можно хранить несколько подписок и выбирать активную группу." Foreground="{ThemeResource MutedBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Добавить" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.AddCommand}" />
                <Button Content="Удалить" Style="{StaticResource DangerButtonStyle}" Command="{x:Bind ViewModel.DeleteCommand}" />
                <Button Content="Сделать активной" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.MakeActiveCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.45*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Url}" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource GoodBrush}" />
                                    <TextBlock Text="ACTIVE" Foreground="{ThemeResource GoodBrush}" Visibility="{x:Bind IsActive}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Редактирование" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Название" Foreground="{ThemeResource MutedBrush}" />
                    <TextBox Text="{x:Bind ViewModel.SelectedItem.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="URL подписки" Foreground="{ThemeResource MutedBrush}" />
                    <TextBox Text="{x:Bind ViewModel.SelectedItem.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap" />
                    <ToggleSwitch Header="Использовать эту подписку" IsOn="{x:Bind ViewModel.SelectedItem.Enabled, Mode=TwoWay}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Интервал обновления, мин." Foreground="{ThemeResource MutedBrush}" />
                            <NumberBox Value="{x:Bind ViewModel.SelectedItem.UpdateIntervalMinutes, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Сортировка" Foreground="{ThemeResource MutedBrush}" />
                            <NumberBox Value="{x:Bind ViewModel.SelectedItem.SortOrder, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="URL шифруется через Windows DPAPI перед записью в settings.json." Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="Сохранить и обновить" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RefreshActiveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
