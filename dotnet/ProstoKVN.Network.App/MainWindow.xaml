<Window
    x:Class="ProstoKVN.Network.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProstoKVN.Network.Core.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Навигация -->
        <Grid Grid.Row="0" Height="64" Padding="24,0" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource CyanBrush}" />
                <TextBlock Text="ProstoKVN Network" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch" Spacing="4">
                <Button Content="▦  Серверы" Style="{StaticResource SecondaryButtonStyle}" BorderBrush="{ThemeResource CyanBrush}" />
                <Button Content="♙  Группа подписки" Style="{StaticResource SecondaryButtonStyle}" Click="OnSubscriptionsClicked" />
                <Button Content="⚙  Настройки" Style="{StaticResource SecondaryButtonStyle}" Click="OnSettingsClicked" />
                <Button Content="?  Помощь" Style="{StaticResource SecondaryButtonStyle}" Click="OnHelpClicked" />
            </StackPanel>
        </Grid>

        <!-- Подписка -->
        <Border Grid.Row="1" Margin="20,12,20,0" Style="{StaticResource CardStyle}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Группа подписки" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="16,0" Background="{ThemeResource FieldBrush}" CornerRadius="8" Padding="14,8">
                    <TextBlock Text="{x:Bind ViewModel.SubscriptionName, Mode=OneWay}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource GoodBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SubscriptionState, Mode=OneWay}" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="4" Content="Управлять" Style="{StaticResource SecondaryButtonStyle}" Click="OnSubscriptionsClicked" />
                <Button Grid.Column="5" Margin="8,0,0,0" Content="⟳  Обновить подписку" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshNodesCommand}" />
            </Grid>
        </Border>

        <!-- Быстрые действия -->
        <Grid Grid.Row="2" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="⟳  Обновить узлы" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RefreshNodesCommand}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="▷  Запустить VPN" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.StartVpnCommand}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="■  Остановить" Style="{StaticResource DangerButtonStyle}" Command="{x:Bind ViewModel.StopVpnCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Ядра" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.InstallCoresCommand}" />
            <TextBox Grid.Column="4" Margin="16,0,0,0" PlaceholderText="Поиск по узлам или протоколам..." Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{ThemeResource FieldBrush}" BorderBrush="{ThemeResource BorderBrush}" CornerRadius="8" />
        </Grid>

        <!-- Карточка подключения -->
        <Border Grid.Row="3" Margin="20,12,20,0" Style="{StaticResource CardStyle}" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="124" Height="124" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="{ThemeResource CyanBrush}" StrokeThickness="3" Opacity="0.35" />
                    <Ellipse Margin="10" Stroke="{ThemeResource CyanBrush}" StrokeThickness="2" />
                    <FontIcon Glyph="&#xEA18;" FontSize="52" Foreground="{ThemeResource CyanBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource GoodBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.VpnState, Mode=OneWay}" Foreground="{ThemeResource GoodBrush}" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.NodeName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="Задержка" Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind ViewModel.UdpState, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="Транспорт" Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Bind ViewModel.NodeRoute, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="Протокол" Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{x:Bind ViewModel.StrategyText, Mode=OneWay}" Foreground="{ThemeResource GoodBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Стратегия" Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Узлы + журнал -->
        <Grid Grid.Row="4" Margin="20,12,20,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="16,14,16,10" Text="Список узлов" FontSize="15" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Padding="16,10" Background="{ThemeResource PanelAltBrush}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Узел" Foreground="{ThemeResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Движок / протокол" Foreground="{ThemeResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="Задержка" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="UDP" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Статус" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" />
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredNodes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NodeModel">
                                <Grid Padding="14,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DisplayServer}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StackLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind LatencyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GoodBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind UdpText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource GoodBrush}" />
                                        <TextBlock Text="{x:Bind TestStatus}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,14,12,10">
                        <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Content="Очистить" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearLogClicked" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.LogLines}" Background="Transparent" BorderThickness="0" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="12,4" Foreground="{ThemeResource SecondaryTextBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Height="48" Padding="22,0" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <TextBlock Text="TUN: system" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock Text="MTU 1400" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.CoreText, Mode=OneWay}" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock Text="RU / SU / РФ: DIRECT" Foreground="{ThemeResource GoodBrush}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StrategyText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
