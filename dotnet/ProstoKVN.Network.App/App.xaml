<Application
    x:Class="ProstoKVN.Network.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#07111F" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#0B1727" />
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#102039" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#0A1A2C" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#1D3A58" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#168DF8" />
                    <SolidColorBrush x:Key="CyanBrush" Color="#22C8FF" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#55E875" />
                    <SolidColorBrush x:Key="BadBrush" Color="#FF5D61" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#7E94AC" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B6C6D9" />
                    <SolidColorBrush x:Key="SelectedBrush" Color="#103D68" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDF3F9" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#F2F7FC" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#F4F8FC" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#CAD8E5" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#1677E8" />
                    <SolidColorBrush x:Key="CyanBrush" Color="#0097C9" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#148A46" />
                    <SolidColorBrush x:Key="BadBrush" Color="#D73C3C" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#73869A" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4E6278" />
                    <SolidColorBrush x:Key="SelectedBrush" Color="#D7EBFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PanelAltBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource BadBrush}" />
            </Style>

            <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
